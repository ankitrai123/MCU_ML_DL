{# Op macros: one per supported IR op (classical tier only in this increment -- tree, linear
   with float32 weights, affine). Each macro emits a fully self-contained block: its own tensor
   storage (declared + `initial`-filled once here, since only one node ever owns a given weight
   tensor), its own local registers, and a small IDLE/RUN/DONE state machine gated by an
   `ef_n<idx>_start` wire the top-level module drives and an `ef_n<idx>_done` reg it drives back.
   Nodes chain by wiring node k's done to node k+1's start (see model.v.j2) -- the same "run to
   completion, then hand off" shape as the C codegen's straight-line sequence of statements,
   just spread across clock cycles instead of executing instantly. Every value is Q16.16 fixed
   point (see fixedpoint.py) except tree index arrays (feature/left/right), which are plain
   integers. #}

{% macro emit_tree(node, ir, idx) %}
{% set feat = ir.tensors[node.attrs.feature] %}
{% set thr = ir.tensors[node.attrs.threshold] %}
{% set left = ir.tensors[node.attrs.left] %}
{% set right = ir.tensors[node.attrs.right] %}
{% set leaf = ir.tensors[node.attrs.leaf_value] %}
{% set in_name = buf_name(node.inputs[0]) %}
{% set out_name = buf_name(node.outputs[0]) %}
{% set n_nodes = feat.shape[0] %}
    // ---- node {{ idx }}: tree '{{ node.name }}' ({{ n_nodes }} tree nodes) ----
    reg signed [31:0] {{ buf_name(feat.name) }} [0:{{ n_nodes - 1 }}];
    reg signed [31:0] {{ buf_name(thr.name) }}  [0:{{ n_nodes - 1 }}];
    reg signed [31:0] {{ buf_name(left.name) }} [0:{{ n_nodes - 1 }}];
    reg signed [31:0] {{ buf_name(right.name) }}[0:{{ n_nodes - 1 }}];
    reg signed [31:0] {{ buf_name(leaf.name) }} [0:{{ n_nodes - 1 }}];
    initial begin
{% for line in tensor_init_lines(feat) %}
{{ line }}
{% endfor %}
{% for line in tensor_init_lines(thr) %}
{{ line }}
{% endfor %}
{% for line in tensor_init_lines(left) %}
{{ line }}
{% endfor %}
{% for line in tensor_init_lines(right) %}
{{ line }}
{% endfor %}
{% for line in tensor_init_lines(leaf) %}
{{ line }}
{% endfor %}
    end

    localparam EF_N{{ idx }}_IDLE = 0, EF_N{{ idx }}_WALK = 1, EF_N{{ idx }}_WRITE = 2, EF_N{{ idx }}_DONE = 3;
    reg [1:0] ef_n{{ idx }}_state;
    reg signed [31:0] ef_n{{ idx }}_node_idx;
    reg signed [31:0] ef_n{{ idx }}_k;
    reg signed [31:0] ef_n{{ idx }}_predicted;
    reg ef_n{{ idx }}_done;

    always @(posedge clk) begin
        if (rst) begin
            ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
            ef_n{{ idx }}_done <= 0;
        end else begin
            case (ef_n{{ idx }}_state)
                EF_N{{ idx }}_IDLE: begin
                    ef_n{{ idx }}_done <= 0;
                    if (ef_n{{ idx }}_start) begin
                        ef_n{{ idx }}_node_idx <= 0;
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_WALK;
                    end
                end
                EF_N{{ idx }}_WALK: begin
                    if ({{ buf_name(feat.name) }}[ef_n{{ idx }}_node_idx] < 0) begin
                        ef_n{{ idx }}_predicted <= ({{ buf_name(leaf.name) }}[ef_n{{ idx }}_node_idx] + 32'sd32768) >>> 16;
                        ef_n{{ idx }}_k <= 0;
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_WRITE;
                    end else if ({{ in_name }}[{{ buf_name(feat.name) }}[ef_n{{ idx }}_node_idx]] <= {{ buf_name(thr.name) }}[ef_n{{ idx }}_node_idx]) begin
                        ef_n{{ idx }}_node_idx <= {{ buf_name(left.name) }}[ef_n{{ idx }}_node_idx];
                    end else begin
                        ef_n{{ idx }}_node_idx <= {{ buf_name(right.name) }}[ef_n{{ idx }}_node_idx];
                    end
                end
                EF_N{{ idx }}_WRITE: begin
{% if node.attrs.is_classifier %}
                    {{ out_name }}[ef_n{{ idx }}_k] <= (ef_n{{ idx }}_k == ef_n{{ idx }}_predicted) ? 32'sd65536 : 32'sd0;
                    if (ef_n{{ idx }}_k == {{ node.attrs.out_size - 1 }}) begin
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_DONE;
                    end else begin
                        ef_n{{ idx }}_k <= ef_n{{ idx }}_k + 1;
                    end
{% else %}
                    {{ out_name }}[0] <= {{ buf_name(leaf.name) }}[ef_n{{ idx }}_node_idx];
                    ef_n{{ idx }}_state <= EF_N{{ idx }}_DONE;
{% endif %}
                end
                EF_N{{ idx }}_DONE: begin
                    ef_n{{ idx }}_done <= 1;
                    ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
                end
            endcase
        end
    end
{% endmacro %}

{% macro emit_linear(node, ir, idx) %}
{% set w = ir.tensors[node.attrs.weight] %}
{% set b = ir.tensors[node.attrs.bias] if node.attrs.bias else none %}
{% set in_name = buf_name(node.inputs[0]) %}
{% set out_name = buf_name(node.outputs[0]) %}
{% set n_out = w.shape[0] %}
{% set n_in = w.shape[1] %}
    // ---- node {{ idx }}: linear '{{ node.name }}' ({{ n_out }}x{{ n_in }}) ----
    reg signed [31:0] {{ buf_name(w.name) }} [0:{{ (n_out * n_in) - 1 }}];
{% if b %}
    reg signed [31:0] {{ buf_name(b.name) }} [0:{{ n_out - 1 }}];
{% endif %}
    initial begin
{% for line in tensor_init_lines(w) %}
{{ line }}
{% endfor %}
{% if b %}
{% for line in tensor_init_lines(b) %}
{{ line }}
{% endfor %}
{% endif %}
    end

    localparam EF_N{{ idx }}_MAC = 0, EF_N{{ idx }}_WRITE = 1, EF_N{{ idx }}_DONE = 2, EF_N{{ idx }}_IDLE = 3;
    reg [1:0] ef_n{{ idx }}_state;
    reg [15:0] ef_n{{ idx }}_i, ef_n{{ idx }}_j;
    reg signed [63:0] ef_n{{ idx }}_acc;
    reg ef_n{{ idx }}_done;

    always @(posedge clk) begin
        if (rst) begin
            ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
            ef_n{{ idx }}_done <= 0;
        end else begin
            case (ef_n{{ idx }}_state)
                EF_N{{ idx }}_IDLE: begin
                    ef_n{{ idx }}_done <= 0;
                    if (ef_n{{ idx }}_start) begin
                        ef_n{{ idx }}_i <= 0; ef_n{{ idx }}_j <= 0; ef_n{{ idx }}_acc <= 0;
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_MAC;
                    end
                end
                EF_N{{ idx }}_MAC: begin
                    ef_n{{ idx }}_acc <= ef_n{{ idx }}_acc
                        + ($signed({{ buf_name(w.name) }}[ef_n{{ idx }}_i * {{ n_in }} + ef_n{{ idx }}_j])
                           * $signed({{ in_name }}[ef_n{{ idx }}_j]));
                    if (ef_n{{ idx }}_j == {{ n_in - 1 }}) begin
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_WRITE;
                    end else begin
                        ef_n{{ idx }}_j <= ef_n{{ idx }}_j + 1;
                    end
                end
                EF_N{{ idx }}_WRITE: begin
                    {{ out_name }}[ef_n{{ idx }}_i] <= (ef_n{{ idx }}_acc >>> 16){% if b %} + {{ buf_name(b.name) }}[ef_n{{ idx }}_i]{% endif %};
                    if (ef_n{{ idx }}_i == {{ n_out - 1 }}) begin
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_DONE;
                    end else begin
                        ef_n{{ idx }}_i <= ef_n{{ idx }}_i + 1;
                        ef_n{{ idx }}_j <= 0;
                        ef_n{{ idx }}_acc <= 0;
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_MAC;
                    end
                end
                EF_N{{ idx }}_DONE: begin
                    ef_n{{ idx }}_done <= 1;
                    ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
                end
            endcase
        end
    end
{% endmacro %}

{% macro emit_affine(node, ir, idx) %}
{% set scale = ir.tensors[node.attrs.scale] %}
{% set shift = ir.tensors[node.attrs.shift] %}
{% set in_name = buf_name(node.inputs[0]) %}
{% set out_name = buf_name(node.outputs[0]) %}
{% set n = scale.shape[0] %}
    // ---- node {{ idx }}: affine '{{ node.name }}' ({{ n }} features) ----
    reg signed [31:0] {{ buf_name(scale.name) }} [0:{{ n - 1 }}];
    reg signed [31:0] {{ buf_name(shift.name) }} [0:{{ n - 1 }}];
    initial begin
{% for line in tensor_init_lines(scale) %}
{{ line }}
{% endfor %}
{% for line in tensor_init_lines(shift) %}
{{ line }}
{% endfor %}
    end

    localparam EF_N{{ idx }}_RUN = 0, EF_N{{ idx }}_DONE = 1, EF_N{{ idx }}_IDLE = 2;
    reg [1:0] ef_n{{ idx }}_state;
    reg [15:0] ef_n{{ idx }}_k;
    reg ef_n{{ idx }}_done;
    // A bare `(a*b) >>> 16` inline would let Verilog's context-determined width rules size the
    // multiply itself to the (32-bit) assignment target -- silently truncating the true product
    // *before* the shift, unlike linear's MAC (safe because its target is already the 64-bit
    // accumulator). Declaring the product as its own 64-bit wire forces the multiply itself to
    // be computed at full width first; found by simulating this exact bug, not by inspection.
    wire signed [63:0] ef_n{{ idx }}_prod = $signed({{ in_name }}[ef_n{{ idx }}_k]) * $signed({{ buf_name(scale.name) }}[ef_n{{ idx }}_k]);

    always @(posedge clk) begin
        if (rst) begin
            ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
            ef_n{{ idx }}_done <= 0;
        end else begin
            case (ef_n{{ idx }}_state)
                EF_N{{ idx }}_IDLE: begin
                    ef_n{{ idx }}_done <= 0;
                    if (ef_n{{ idx }}_start) begin
                        ef_n{{ idx }}_k <= 0;
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_RUN;
                    end
                end
                EF_N{{ idx }}_RUN: begin
                    {{ out_name }}[ef_n{{ idx }}_k] <= (ef_n{{ idx }}_prod >>> 16) + {{ buf_name(shift.name) }}[ef_n{{ idx }}_k];
                    if (ef_n{{ idx }}_k == {{ n - 1 }}) begin
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_DONE;
                    end else begin
                        ef_n{{ idx }}_k <= ef_n{{ idx }}_k + 1;
                    end
                end
                EF_N{{ idx }}_DONE: begin
                    ef_n{{ idx }}_done <= 1;
                    ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
                end
            endcase
        end
    end
{% endmacro %}

{% macro emit_activation(node, ir, idx) %}
{% set t = ir.tensors[node.inputs[0]] %}
{% set buf = buf_name(node.inputs[0]) %}
{% set kind = node.attrs.kind %}
    // ---- node {{ idx }}: activation '{{ node.name }}' (kind={{ kind }}, {{ t.size }} elements, in place) ----
    localparam EF_N{{ idx }}_RUN = 0, EF_N{{ idx }}_DONE = 1, EF_N{{ idx }}_IDLE = 2;
    reg [1:0] ef_n{{ idx }}_state;
    reg [15:0] ef_n{{ idx }}_k;
    reg ef_n{{ idx }}_done;

    always @(posedge clk) begin
        if (rst) begin
            ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
            ef_n{{ idx }}_done <= 0;
        end else begin
            case (ef_n{{ idx }}_state)
                EF_N{{ idx }}_IDLE: begin
                    ef_n{{ idx }}_done <= 0;
                    if (ef_n{{ idx }}_start) begin
                        ef_n{{ idx }}_k <= 0;
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_RUN;
                    end
                end
                EF_N{{ idx }}_RUN: begin
{% if kind == 'relu' %}
                    if ($signed({{ buf }}[ef_n{{ idx }}_k]) < 0) begin
                        {{ buf }}[ef_n{{ idx }}_k] <= 0;
                    end
{% elif kind == 'relu6' %}
                    if ($signed({{ buf }}[ef_n{{ idx }}_k]) < 0) begin
                        {{ buf }}[ef_n{{ idx }}_k] <= 0;
                    end else if ($signed({{ buf }}[ef_n{{ idx }}_k]) > {{ fixed_literal(6.0) }}) begin
                        {{ buf }}[ef_n{{ idx }}_k] <= {{ fixed_literal(6.0) }};
                    end
{% endif %}
                    if (ef_n{{ idx }}_k == {{ t.size - 1 }}) begin
                        ef_n{{ idx }}_state <= EF_N{{ idx }}_DONE;
                    end else begin
                        ef_n{{ idx }}_k <= ef_n{{ idx }}_k + 1;
                    end
                end
                EF_N{{ idx }}_DONE: begin
                    ef_n{{ idx }}_done <= 1;
                    ef_n{{ idx }}_state <= EF_N{{ idx }}_IDLE;
                end
            endcase
        end
    end
{% endmacro %}

{% macro emit_node(node, ir, idx) %}
{% if node.op == 'tree' %}
{{ emit_tree(node, ir, idx) }}
{% elif node.op == 'linear' %}
{{ emit_linear(node, ir, idx) }}
{% elif node.op == 'affine' %}
{{ emit_affine(node, ir, idx) }}
{% elif node.op == 'activation' %}
{{ emit_activation(node, ir, idx) }}
{% endif %}
{% endmacro %}
