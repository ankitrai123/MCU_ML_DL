/* Auto-generated by EdgeForge {{ edgeforge_version }} for board '{{ board.id }}'.
 * Generic two-region (flash + RAM) GNU ld script: only the region sizes and
 * origins are board-specific data (from boards/{{ board.id }}.yaml), the section
 * layout below is the same for every GNU-ld-targeting board in the registry. */
MEMORY {
  FLASH (rx) : ORIGIN = {{ hex32(board.toolchain.linker_origins.flash) }}, LENGTH = {{ board.memory.flash_bytes }}
  RAM (rwx)  : ORIGIN = {{ hex32(board.toolchain.linker_origins.ram) }}, LENGTH = {{ board.memory.ram_bytes }}
}

_estack = ORIGIN(RAM) + LENGTH(RAM);

SECTIONS {
  .isr_vector : {
    KEEP(*(.isr_vector))
  } > FLASH

  .text : {
    *(.text*)
  } > FLASH

  .rodata : {
    *(.rodata*)
  } > FLASH

  _sidata = LOADADDR(.data);
  .data : {
    _sdata = .;
    *(.data*)
    _edata = .;
  } > RAM AT> FLASH

  .bss : {
    _sbss = .;
    *(.bss*)
    _ebss = .;
  } > RAM
}
